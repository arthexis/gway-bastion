#!/usr/bin/env python3
"""Install a GitHub token only if it is valid for at least six months."""

from __future__ import annotations

import argparse
import datetime as dt
import getpass
import json
import os
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any


HOME = Path("/home/arthe")
GH_BIN = Path("/usr/bin/gh")
GH_HOSTS = HOME / ".config" / "gh" / "hosts.yml"
GIT_CREDENTIALS = HOME / ".git-credentials"
STATE_PATH = HOME / ".local" / "state" / "github-credentials" / "status.json"
MIN_VALID_DAYS = 183
REQUIRED_SCOPES = {"repo", "read:org"}


def utc_now() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def iso(value: dt.datetime | None = None) -> str:
    return (value or utc_now()).isoformat(timespec="seconds")


def read_token(args: argparse.Namespace) -> str:
    if args.token_file:
        token = Path(args.token_file).read_text(encoding="utf-8").strip()
    elif not sys.stdin.isatty():
        token = sys.stdin.read().strip()
    else:
        token = getpass.getpass("GitHub token: ").strip()

    token = token.replace("\r", "").replace("\n", "")
    if not token:
        raise SystemExit("No token provided.")
    return token


def parse_expiration(value: str | None) -> dt.datetime | None:
    if not value:
        return None
    try:
        return dt.datetime.strptime(value, "%Y-%m-%d %H:%M:%S %Z").replace(tzinfo=dt.timezone.utc)
    except ValueError:
        return None


def github_user(token: str) -> tuple[dict[str, Any], dict[str, str]]:
    request = urllib.request.Request(
        "https://api.github.com/user",
        headers={
            "Accept": "application/vnd.github+json",
            "Authorization": f"Bearer {token}",
            "User-Agent": "github-credential-rotate",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            body = json.loads(response.read().decode("utf-8"))
            headers = {key.lower(): value for key, value in response.headers.items()}
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise SystemExit(f"GitHub rejected the token: HTTP {exc.code} {detail}") from exc
    except (OSError, TimeoutError, urllib.error.URLError, json.JSONDecodeError) as exc:
        raise SystemExit(f"Could not validate token with GitHub: {exc}") from exc
    return body, headers


def validate_expiration(headers: dict[str, str], min_until: dt.datetime) -> tuple[str, bool]:
    raw_expiration = headers.get("github-authentication-token-expiration")
    expiration = parse_expiration(raw_expiration)
    if expiration is None:
        return raw_expiration or "not reported by GitHub", True
    if expiration < min_until:
        raise SystemExit(
            "Refusing to install token: "
            f"expires {expiration.strftime('%Y-%m-%d %H:%M:%S UTC')}, "
            f"before required {min_until.strftime('%Y-%m-%d %H:%M:%S UTC')}."
        )
    return expiration.strftime("%Y-%m-%d %H:%M:%S UTC"), True


def validate_scopes(headers: dict[str, str]) -> str:
    scopes_raw = headers.get("x-oauth-scopes", "")
    scopes = {scope.strip() for scope in scopes_raw.split(",") if scope.strip()}
    if scopes and not REQUIRED_SCOPES.issubset(scopes):
        missing = ", ".join(sorted(REQUIRED_SCOPES - scopes))
        raise SystemExit(f"Refusing to install token: missing required scopes: {missing}.")
    return scopes_raw or "not reported by GitHub"


def run(argv: list[str], *, input_text: str | None = None, timeout: int = 30) -> tuple[int, str]:
    try:
        result = subprocess.run(
            argv,
            input=input_text,
            text=True,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
    except FileNotFoundError:
        return 127, f"not found: {argv[0]}"
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {timeout}s: {' '.join(argv)}"
    return result.returncode, result.stdout.strip()


def backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    suffix = utc_now().strftime("%Y%m%d%H%M%S")
    target = path.with_name(f"{path.name}.bak-{suffix}")
    target.write_bytes(path.read_bytes())
    os.chmod(target, stat.S_IRUSR | stat.S_IWUSR)
    return target


def install_gh_token(token: str) -> str:
    GH_HOSTS.parent.mkdir(parents=True, exist_ok=True)
    backup(GH_HOSTS)
    code, output = run(
        [
            str(GH_BIN),
            "auth",
            "login",
            "--hostname",
            "github.com",
            "--git-protocol",
            "https",
            "--with-token",
        ],
        input_text=f"{token}\n",
        timeout=60,
    )
    if code != 0:
        raise SystemExit(f"gh auth login failed: {output}")
    return "installed"


def install_git_credential(login: str, token: str) -> str:
    backup(GIT_CREDENTIALS)
    GIT_CREDENTIALS.parent.mkdir(parents=True, exist_ok=True)
    existing: list[str] = []
    if GIT_CREDENTIALS.exists():
        existing = [
            line
            for line in GIT_CREDENTIALS.read_text(encoding="utf-8").splitlines()
            if "@github.com" not in line
        ]

    username = urllib.parse.quote(login or "arthexis", safe="")
    password = urllib.parse.quote(token, safe="")
    existing.append(f"https://{username}:{password}@github.com")
    GIT_CREDENTIALS.write_text("\n".join(existing) + "\n", encoding="utf-8")
    os.chmod(GIT_CREDENTIALS, stat.S_IRUSR | stat.S_IWUSR)

    code, output = run(["git", "config", "--global", "credential.helper", "store"], timeout=15)
    if code != 0:
        raise SystemExit(f"git credential helper update failed: {output}")
    return "installed"


def write_state(state: dict[str, Any]) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        dir=str(STATE_PATH.parent),
        prefix=".status.",
        delete=False,
    ) as handle:
        json.dump(state, handle, indent=2, sort_keys=True)
        handle.write("\n")
        tmp_name = handle.name
    Path(tmp_name).replace(STATE_PATH)
    os.chmod(STATE_PATH, stat.S_IRUSR | stat.S_IWUSR)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--token-file", help="Read token from this file instead of stdin or prompt.")
    parser.add_argument("--min-valid-days", type=int, default=MIN_VALID_DAYS)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    min_until = utc_now() + dt.timedelta(days=args.min_valid_days)
    token = read_token(args)
    user, headers = github_user(token)
    login = str(user.get("login") or "")
    expiration_text, _ = validate_expiration(headers, min_until)
    scopes_text = validate_scopes(headers)

    gh_status = install_gh_token(token)
    git_status = install_git_credential(login, token)

    state = {
        "checked_at": iso(),
        "github_login": login,
        "minimum_required_until": min_until.strftime("%Y-%m-%d %H:%M:%S UTC"),
        "token_expiration": expiration_text,
        "token_scopes": scopes_text,
        "gh_hosts": gh_status,
        "git_credentials": git_status,
    }
    write_state(state)

    print("github credential rotation complete")
    print(f"github_login: {login}")
    print(f"minimum_required_until: {state['minimum_required_until']}")
    print(f"token_expiration: {expiration_text}")
    print(f"token_scopes: {scopes_text}")
    print(f"gh_hosts: {gh_status}")
    print(f"git_credentials: {git_status}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
