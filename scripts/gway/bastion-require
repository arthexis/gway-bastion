#!/usr/bin/env bash
set -euo pipefail

operation="${1:-This action}"
checker="${BASTION_KEY_PRESENT:-/usr/local/libexec/bastion-key-present}"

if [[ -x "$checker" ]] && "$checker" --quiet; then
  exit 0
fi

printf '%s requires the verified bastion USB key on gway-001.\n' "$operation" >&2
printf 'Insert the key containing bastion/unlock.pass and retry.\n' >&2
exit 75
