#!/usr/bin/env bash
# Clear pending RFID work only when verified bastion-key state changes.
set -euo pipefail

readonly USER_NAME="arthe"
readonly KEY_CHECK="/usr/local/libexec/bastion-key-present"
readonly STATE_FILE="/run/bastion-ssh/rfid-queue-key-state"
readonly QUEUE_RUNNER="/home/arthe/.local/bin/rfid-mode-runner"

mkdir -p "$(dirname "$STATE_FILE")"
if "$KEY_CHECK" --quiet; then
    current="present"
else
    current="absent"
fi

previous=""
if [[ -r "$STATE_FILE" ]]; then
    previous="$(tr -d '[:space:]' < "$STATE_FILE" 2>/dev/null || true)"
fi
printf '%s\n' "$current" >"$STATE_FILE"

# The first run establishes a baseline. The periodic refresh timer must not
# clear RFID work merely because it ran.
if [[ -z "$previous" || "$previous" == "$current" ]]; then
    exit 0
fi

if [[ -x "$QUEUE_RUNNER" ]]; then
    runuser -u "$USER_NAME" -- "$QUEUE_RUNNER" --request-queue-clear \
        --reason "bastion-key-${previous}-to-${current}"
fi
