USB_GIT_OWNER_HOME=/home/arthe
USB_GIT_FIXED_DIR=/mnt/bastion-unlock/bastion
USB_GIT_LEGACY_FIXED_DIR=/mnt/bastion-unlock/bastion-ssh
USB_GIT_CONFIG_DIR=/home/arthe/.config/usb-git
USB_GIT_ADMIN_TOKEN_ENC=/home/arthe/.config/usb-git/admin-token.enc
